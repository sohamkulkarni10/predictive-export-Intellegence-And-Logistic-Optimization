# Groq LLM (paste your key after the =). Leave empty to use Python fallback explanations.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Databricks SQL warehouse (optional — local mode uses models/last_run.json instead)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=export_ai
DATABRICKS_SCHEMA=main

# Kafka / Confluent Cloud (optional — used by producers/stream jobs, not required for local Flask)
KAFKA_BOOTSTRAP=
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_TOPIC_DEMAND=export-ai-demand-news
KAFKA_TOPIC_PRICE=export-ai-price-news
