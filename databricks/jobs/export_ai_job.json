{
  "name": "export_ai_pipeline",
  "timeout_seconds": 86400,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "kafka_to_bronze",
      "description": "Confluent Cloud -> bronze_news (availableNow catch-up)",
      "notebook_task": {
        "notebook_path": "databricks/02_kafka_stream_bronze",
        "source": "GIT"
      },
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 1,
        "spark_conf": {
          "spark.databricks.delta.preview.enabled": "true"
        }
      },
      "timeout_seconds": 3600,
      "max_retries": 1
    },
    {
      "task_key": "score_silver",
      "description": "bronze_news -> silver_news_scored",
      "depends_on": [{ "task_key": "kafka_to_bronze" }],
      "notebook_task": {
        "notebook_path": "databricks/03_score_silver",
        "source": "GIT"
      },
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 1
      },
      "libraries": [
        { "pypi": { "package": "scikit-learn" } },
        { "pypi": { "package": "joblib" } }
      ],
      "timeout_seconds": 3600,
      "max_retries": 1
    },
    {
      "task_key": "daily_gold",
      "description": "silver -> gold_demand_daily + gold_price_forecast + gold_export_decisions",
      "depends_on": [{ "task_key": "score_silver" }],
      "notebook_task": {
        "notebook_path": "databricks/05_daily_predictions_gold",
        "source": "GIT"
      },
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 1
      },
      "libraries": [
        { "pypi": { "package": "scikit-learn" } },
        { "pypi": { "package": "xgboost" } },
        { "pypi": { "package": "joblib" } }
      ],
      "timeout_seconds": 3600,
      "max_retries": 1
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "Asia/Kolkata",
    "pause_status": "UNPAUSED"
  },
  "git_source": {
    "git_url": "https://github.com/YOUR_ORG/Export_AI.git",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "tags": {
    "project": "export_ai",
    "layer": "databricks"
  },
  "format": "MULTI_TASK",
  "_comment": "One-time setup notebooks 00/01/04 are run manually. This job is the daily streaming catch-up + silver + gold path. For a 24/7 stream, change 02 to continuous trigger and run kafka_to_bronze as a separate always-on job without schedule."
}
